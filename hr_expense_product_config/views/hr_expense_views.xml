<odoo>
    <record id="view_expense_form" model="ir.ui.view">
        <field name="name">hr.expense.view.form (in hr_expense_product_config)</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <field name="payment_mode" position="before">
                <field name="payment_locked" invisible="1"/>
            </field>
            <field name="payment_mode" position="attributes">
                <attribute name="readonly">payment_locked</attribute>
                <attribute name="force_save">1</attribute>
            </field>
            <field name="product_id" position="before">
                <field name="allowed_product_ids" invisible="1"/>
            </field>
            <field name="product_id" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_product_ids)]</attribute>
            </field>
        </field>
    </record>
</odoo>
