<odoo>
    <record id="hr_expense_product_conf_comp_rule" model="ir.rule">
        <field name="name">Hr Expense Product Conf multi-company</field>
        <field name="model_id" ref="hr_expense_product_config.model_hr_employee_expense_config" />
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids + [False])]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
