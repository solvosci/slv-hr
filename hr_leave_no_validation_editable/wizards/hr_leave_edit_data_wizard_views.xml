<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_edit_data_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.leave.edit.data.wizard.form</field>
        <field name="model">hr.leave.edit.data.wizard</field>
        <field name="arch" type="xml">
            <form string="Edit Data">
                <field name="holiday_status_id" invisible="1"/>
                <field name="request_unit_hours" invisible="1"/>
                <field name="request_unit_half" invisible="1"/>
                <field name="date_from" invisible="1"/>
                <field name="date_to" invisible="1"/>
                <group>
                    <group>
                        <field name="request_date_from"/>
                    </group>
                    <group>
                        <field name="request_date_to" attrs="{'invisible': ['|',('request_unit_half', '!=', False), ('request_unit_hours', '!=', False)]}"/>
                    </group>
                    <group>
                        <field name="request_hour_from" attrs="{'invisible': [('request_unit_hours', '=', False)]}"/>
                    </group>
                    <group>
                        <field name="request_hour_to" attrs="{'invisible': [('request_unit_hours', '=', False)]}"/>
                    </group>
                    <field name="name"/>
                </group>
                <footer>
                    <button name="action_edit_data" string="Edit Data" type="object" class="btn-primary"/>
                    <button name="cancel" string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
