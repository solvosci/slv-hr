<odoo>
    <record id="view_hr_leave_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.form (in hr_leave_attach_autovalidated)</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supported_attachment_ids']" position="attributes">
                <!-- invisible="not leave_type_support_document or state not in ('draft', 'confirm', 'validate1')" -->
                <attribute name="invisible">not leave_type_support_document</attribute>
            </xpath>
            <xpath expr="//label[@for='supported_attachment_ids']" position="attributes">
                <!-- invisible="not leave_type_support_document or state not in ('draft', 'confirm', 'validate1')" -->
                <attribute name="invisible">not leave_type_support_document</attribute>
            </xpath>
        </field>
    </record>

</odoo>
